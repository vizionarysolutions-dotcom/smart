<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SMART Contracting Solutions</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Rajdhani:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  a { text-decoration: none; }

  /* CMS-proof wrapper: forces dark bg even if host injects light styles */
  #smart-app {
    background: #06091a !important;
    color: #e8eeff !important;
    font-family: 'Rajdhani', sans-serif !important;
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
  }

  #smart-app * { box-sizing: border-box; }

  :root {
    --cyan: #00d4ff;
    --purple: #b44dff;
    --dark: #06091a;
    --border-cyan: rgba(0, 212, 255, 0.35);
    --text: #e8eeff;
    --muted: #7a85b0;
  }

  .grid-bg {
    position: fixed; inset: 0; pointer-events: none; z-index: 0;
    background-image:
      linear-gradient(rgba(0,212,255,0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,212,255,0.07) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  .grid-bg::after {
    content: ''; position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 50% 0%, transparent 40%, #06091a 100%),
      radial-gradient(ellipse 100% 40% at 50% 100%, #06091a 0%, transparent 60%);
  }

  .grid-floor {
    position: fixed; bottom: 0; left: -20%; width: 140%; height: 60vh;
    pointer-events: none; z-index: 0;
    background-image:
      linear-gradient(rgba(0,212,255,0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,212,255,0.12) 1px, transparent 1px);
    background-size: 80px 80px;
    transform: rotateX(65deg); transform-origin: bottom center;
    mask-image: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 70%);
    -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 70%);
  }

  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 1rem 3rem;
    background: rgba(6,9,26,0.85) !important;
    backdrop-filter: blur(12px);
    border-bottom: 0.5px solid var(--border-cyan);
  }

  .nav-logo {
    font-family: 'Orbitron', monospace; font-size: 1.1rem; font-weight: 700;
    color: var(--cyan); letter-spacing: 2px;
  }

  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a { color: var(--muted); font-size: 0.9rem; letter-spacing: 1px; text-transform: uppercase; transition: color 0.2s; }
  .nav-links a:hover { color: var(--cyan); }

  .nav-cta {
    background: transparent; border: 1px solid var(--cyan); color: var(--cyan);
    padding: 0.45rem 1.2rem; font-family: 'Rajdhani', sans-serif;
    font-size: 0.85rem; letter-spacing: 1.5px; text-transform: uppercase;
    cursor: pointer; transition: background 0.2s, color 0.2s; border-radius: 3px;
  }
  .nav-cta:hover { background: var(--cyan); color: #06091a; }

  .page {
    position: relative; z-index: 1; min-height: 100vh;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 6rem 2rem 3rem; gap: 2rem;
  }

  .hero {
    display: grid; grid-template-columns: 1fr auto 1fr;
    align-items: center; gap: 3rem; width: 100%; max-width: 1200px;
  }

  .side-panel { display: flex; flex-direction: column; gap: 1rem; }
  .side-panel.right { align-items: flex-end; }

  .panel-header { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; }

  .avatar-circle {
    width: 90px; height: 90px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
  }
  .avatar-circle.blue {
    background: radial-gradient(circle at 35% 35%, #3ae8ff, #007acc);
    box-shadow: 0 0 30px rgba(0,212,255,0.5), 0 0 60px rgba(0,212,255,0.2);
  }
  .avatar-circle.violet {
    background: radial-gradient(circle at 35% 35%, #d580ff, #7a00cc);
    box-shadow: 0 0 30px rgba(180,77,255,0.5), 0 0 60px rgba(180,77,255,0.2);
  }
  .avatar-circle svg { width: 42px; height: 42px; fill: white; }

  .panel-label {
    font-family: 'Orbitron', monospace; font-size: 1rem; font-weight: 900;
    letter-spacing: 3px; color: white; text-align: center;
  }

  .feature-row {
    display: flex; align-items: center; gap: 0.75rem;
    background: rgba(13,18,48,0.8);
    border: 0.5px solid rgba(0,212,255,0.2);
    border-left: 2px solid var(--cyan);
    padding: 0.75rem 1.1rem; border-radius: 4px;
    width: 100%; max-width: 320px;
    transition: background 0.2s, transform 0.15s; cursor: pointer;
  }
  .feature-row:hover { background: rgba(0,212,255,0.08); transform: translateX(-4px); }

  .side-panel.right .feature-row {
    flex-direction: row-reverse;
    border-left: 0.5px solid rgba(180,77,255,0.2);
    border-right: 2px solid var(--purple);
  }
  .side-panel.right .feature-row:hover { background: rgba(180,77,255,0.08); transform: translateX(4px); }

  .feature-icon { width: 32px; height: 32px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
  .feature-icon svg { width: 20px; height: 20px; }
  .feature-row .feature-icon svg { fill: var(--cyan); }
  .side-panel.right .feature-row .feature-icon svg { fill: var(--purple); }
  .feature-label { font-size: 1rem; font-weight: 500; letter-spacing: 0.5px; color: var(--text); }

  .hub { display: flex; flex-direction: column; align-items: center; gap: 1.25rem; }

  .hub-card {
    width: 160px; height: 160px;
    background: rgba(10,14,40,0.95);
    border: 1px solid rgba(120,80,255,0.5); border-radius: 18px;
    display: flex; align-items: center; justify-content: center;
    animation: pulse-glow 3s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%,100% { box-shadow: 0 0 40px rgba(120,80,255,0.25), inset 0 0 30px rgba(120,80,255,0.05); }
    50%      { box-shadow: 0 0 60px rgba(120,80,255,0.45), inset 0 0 40px rgba(120,80,255,0.1); }
  }

  .hub-card svg { width: 68px; height: 68px; fill: rgba(200,200,240,0.85); }
  .hub-title { text-align: center; }

  .hub-title .smart {
    font-family: 'Orbitron', monospace; font-size: 2rem; font-weight: 900;
    background: linear-gradient(90deg, var(--cyan), var(--purple));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    letter-spacing: 4px;
  }

  .hub-title .sub { font-size: 0.85rem; letter-spacing: 3px; color: var(--muted); text-transform: uppercase; margin-top: 0.2rem; }

  .tagline { text-align: center; max-width: 600px; }
  .tagline h1 { font-family: 'Orbitron', monospace; font-size: 1.5rem; font-weight: 700; color: white; letter-spacing: 2px; margin-bottom: 0.75rem; line-height: 1.4; }
  .tagline p { color: var(--muted); font-size: 1rem; line-height: 1.7; letter-spacing: 0.5px; }

  .cta-group { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }

  .btn-primary {
    background: linear-gradient(90deg, var(--cyan), #0099cc); color: #06091a; border: none;
    padding: 0.75rem 2rem; font-family: 'Orbitron', monospace; font-size: 0.75rem;
    font-weight: 700; letter-spacing: 2px; text-transform: uppercase;
    cursor: pointer; border-radius: 4px; transition: opacity 0.2s, transform 0.15s;
  }
  .btn-primary:hover { opacity: 0.85; transform: translateY(-2px); }

  .btn-secondary {
    background: transparent; color: var(--purple); border: 1px solid var(--purple);
    padding: 0.75rem 2rem; font-family: 'Orbitron', monospace; font-size: 0.75rem;
    font-weight: 700; letter-spacing: 2px; text-transform: uppercase;
    cursor: pointer; border-radius: 4px; transition: background 0.2s, transform 0.15s;
  }
  .btn-secondary:hover { background: rgba(180,77,255,0.12); transform: translateY(-2px); }

  .stats-bar {
    display: flex; gap: 3rem; padding: 1.5rem 3rem;
    background: rgba(13,18,48,0.7); border: 0.5px solid var(--border-cyan);
    border-radius: 8px; flex-wrap: wrap; justify-content: center;
  }
  .stat { display: flex; flex-direction: column; align-items: center; gap: 0.2rem; }
  .stat-num {
    font-family: 'Orbitron', monospace; font-size: 1.5rem; font-weight: 900;
    background: linear-gradient(90deg, var(--cyan), var(--purple));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .stat-label { font-size: 0.75rem; letter-spacing: 2px; text-transform: uppercase; color: var(--muted); }

  @media (max-width: 768px) {
    .hero { grid-template-columns: 1fr; gap: 1.5rem; }
    .side-panel, .side-panel.right { align-items: center; }
    .feature-row:hover, .side-panel.right .feature-row:hover { transform: none; }
    .nav-links { display: none; }
    nav { padding: 1rem 1.5rem; }
  }
</style>
</head>
<body>

<div id="smart-app">

  <div class="grid-bg"></div>
  <div class="grid-floor"></div>

  <nav>
    <div class="nav-logo">SMART</div>
    <ul class="nav-links">
      <li><a href="#">How it works</a></li>
      <li><a href="#">For Business</a></li>
      <li><a href="#">For Talent</a></li>
      <li><a href="#">Pricing</a></li>
    </ul>
    <a href="mailto:get@smart-contracting.io"><button class="nav-cta">Get Started</button></a>
  </nav>

  <div class="page">
    <div class="hero">

      <!-- LEFT: BUSINESS -->
      <div class="side-panel left">
        <div class="panel-header">
          <div class="avatar-circle blue">
            <svg viewBox="0 0 24 24"><path d="M3 21V5a2 2 0 012-2h14a2 2 0 012 2v16M9 21V11h6v10M3 21h18M7 8h2M7 12h2M15 8h2M15 12h2"/></svg>
          </div>
          <div class="panel-label">BUSINESS</div>
        </div>
        <div class="feature-row">
          <div class="feature-icon"><svg viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2zM16 3H8a1 1 0 00-1 1v3h10V4a1 1 0 00-1-1z"/></svg></div>
          <span class="feature-label">Job Requirements</span>
        </div>
        <div class="feature-row">
          <div class="feature-icon"><svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z"/></svg></div>
          <span class="feature-label">Location</span>
        </div>
        <div class="feature-row">
          <div class="feature-icon"><svg viewBox="0 0 24 24"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1H8.11c.12 2.19 1.76 3.42 3.69 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg></div>
          <span class="feature-label">Budget</span>
        </div>
      </div>

      <!-- CENTER HUB -->
      <div class="hub">
        <div class="hub-card">
          <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6zM14 3.5L18.5 8H14V3.5zM8 13h8v1.5H8V13zm0 3h5v1.5H8V16zm0-6h3v1.5H8V10z"/></svg>
        </div>
        <div class="hub-title">
          <div class="smart">SMART</div>
          <div class="sub">Contracting Solutions</div>
        </div>
      </div>

      <!-- RIGHT: TALENT -->
      <div class="side-panel right">
        <div class="panel-header">
          <div class="avatar-circle violet">
            <svg viewBox="0 0 24 24"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
          </div>
          <div class="panel-label">TALENT</div>
        </div>
        <div class="feature-row">
          <div class="feature-icon"><svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg></div>
          <span class="feature-label">Experience</span>
        </div>
        <div class="feature-row">
          <div class="feature-icon"><svg viewBox="0 0 24 24"><path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/></svg></div>
          <span class="feature-label">Skills</span>
        </div>
        <div class="feature-row">
          <div class="feature-icon"><svg viewBox="0 0 24 24"><path d="M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z"/></svg></div>
          <span class="feature-label">Background</span>
        </div>
      </div>

    </div>

    <div class="tagline">
      <h1>Where Great Businesses<br>Meet Top Talent</h1>
      <p>AI-powered matching that connects businesses with verified contractors — faster, smarter, and more precise than ever before.</p>
    </div>

    <div class="cta-group">
      <a href="mailto:get@smart-contracting.io"><button class="btn-primary">Post a Job</button></a>
      <a href="mailto:get@smart-contracting.io"><button class="btn-secondary">Find Work</button></a>
    </div>

    <div class="stats-bar">
      <div class="stat"><span class="stat-num">12K+</span><span class="stat-label">Active Contractors</span></div>
      <div class="stat"><span class="stat-num">98%</span><span class="stat-label">Match Accuracy</span></div>
      <div class="stat"><span class="stat-num">3.2K</span><span class="stat-label">Businesses Served</span></div>
      <div class="stat"><span class="stat-num">48h</span><span class="stat-label">Avg Time to Match</span></div>
    </div>

  </div>
</div>

<script>
  const rows = document.querySelectorAll('.feature-row');
  rows.forEach((row, i) => {
    row.style.opacity = '0';
    row.style.transform = 'translateY(20px)';
    row.style.transition = `opacity 0.5s ease ${i*0.1+0.3}s, transform 0.5s ease ${i*0.1+0.3}s, background 0.2s`;
    setTimeout(() => { row.style.opacity = '1'; row.style.transform = 'translateY(0)'; }, 100);
  });
  const hub = document.querySelector('.hub-card');
  hub.style.opacity = '0';
  hub.style.transform = 'scale(0.8)';
  hub.style.transition = 'opacity 0.6s ease 0.1s, transform 0.6s ease 0.1s';
  setTimeout(() => { hub.style.opacity = '1'; hub.style.transform = 'scale(1)'; }, 100);
</script>
</body>
</html>
